---
/* ==========================================================================
   404 / Not found
   --------------------------------------------------------------------------
   GitHub Pages 会把根目录的 404.html 用作全站找不到路径时的响应。

   注意链接必须带 base：404 是在**任意深度**的 URL 上触发的，
   相对路径会按那个 URL 解析（例如 /jbyangc-site/foo/bar 下，
   href="index.html" 会指向 /jbyangc-site/foo/index.html）。
   ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="页面不存在 | TEAM JBYangC"
  description="这个页面不存在，或者链接已经失效。"
>

  <div class="shell" style="min-height:70vh;display:grid;place-items:center;text-align:center">
    <div>
      <div class="eyebrow" style="justify-content:center">404</div>
      <h1 class="section__title" style="margin-bottom:18px">这一页不存在</h1>
      <p class="section__lede" style="margin-bottom:28px">
        链接可能已经失效，或者地址打错了。下面几个地方可以继续逛。
      </p>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href={base}>回到首页</a>
        <a class="btn btn--ghost" href={base + 'players.html'}>选手阵容</a>
        <a class="btn btn--ghost" href={base + 'media.html'}>素材库</a>
      </p>
    </div>
  </div>

</BaseLayout>

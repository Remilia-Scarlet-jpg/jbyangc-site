---
/* ==========================================================================
   关注我们 / Follow
   --------------------------------------------------------------------------
   频道卡与联络网格由 data.js 的 CONTACT 渲染：有 href 的显示为可点卡片，
   留空的显示为「待开通」。所以以后开通 QQ / Discord 只需要改 data.js。

   页面自带的 <style> 用了 is:global —— .channel 与 .contact 的内容
   全部由 innerHTML 生成，没有 Astro 注入的 scope 属性。
   ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="关注我们 | TEAM JBYangC"
  description="关注 TEAM JBYangC：队内对局片段、入场动画与新素材发布在哔哩哔哩频道。"
>

  <section class="section" style="padding-top:calc(var(--nav-h) + 78px);padding-bottom:44px">
    <div class="shell">
      <div class="section__head" style="max-width:840px">
        <div class="eyebrow reveal" data-i18n="fl.eyebrow">Follow us</div>
        <h1 class="section__title reveal" style="--d:80ms;font-size:clamp(34px,5.4vw,58px)" data-i18n="fl.title">
          关注我们
        </h1>
        <p class="section__lede reveal" style="--d:160ms" data-i18n="fl.lede">
          队内对局片段、入场动画、印花与新素材，都发在哔哩哔哩频道。
          目前我们只运营这一个账号 —— 想看到更新，在这里关注就够了。
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="shell">
      <div class="channel reveal reveal--scale" id="channel-featured">
        {/* 由脚本填充 */}
      </div>
    </div>
  </section>

  <section class="section section--divide" style="padding-top:0">
    <div class="shell">
      <div class="section__head">
        <div class="eyebrow reveal" data-i18n="fl.contentEyebrow">What we post</div>
        <h2 class="section__title reveal" style="--d:80ms" data-i18n="fl.contentTitle">频道里会有什么</h2>
      </div>

      <div class="grid grid--3" data-stagger="100">
        <article class="card reveal">
          <div class="card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/></svg>
          </div>
          <h3 class="card__title" data-i18n="fl.c1t">对局片段</h3>
          <p class="card__text" data-i18n="fl.c1d">
            队内对抗与组队局里值得留下的片段。高光会剪，失误也不会藏着 ——
            本来就是我们真实的样子。
          </p>
        </article>

        <article class="card reveal">
          <div class="card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>
          </div>
          <h3 class="card__title" data-i18n="fl.c2t">队徽与入场动画</h3>
          <p class="card__text" data-i18n="fl.c2d">
            队徽动画、入场序列的成片与新版本。这些素材在
            <a href="media.html" style="color:var(--cyan)">素材库</a> 里也能直接看。
          </p>
        </article>

        <article class="card reveal">
          <div class="card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5L5 21"/></svg>
          </div>
          <h3 class="card__title" data-i18n="fl.c3t">印花与周边</h3>
          <p class="card__text" data-i18n="fl.c3d">
            队服设计、选手印花、贴纸与签名的发布与更新，
            新做出来一张就更新一次。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--divide" style="padding-top:0">
    <div class="shell">
      <div class="section__head">
        <div class="eyebrow reveal" data-i18n="fl.otherEyebrow">Other channels</div>
        <h2 class="section__title reveal" style="--d:80ms" data-i18n="fl.otherTitle">其他账号</h2>
        <p class="section__lede reveal" style="--d:160ms" data-i18n="fl.otherLede">
          目前只有 B 站一个正式账号。下面这些渠道还在准备，
          开通之后会在这里补上。
        </p>
      </div>

      <div class="contact-grid reveal" data-stagger="80" id="contact-grid"></div>
    </div>
  </section>

  <section class="section section--divide" style="padding-top:0">
    <div class="shell">
      <div class="section__head">
        <div class="eyebrow reveal" data-i18n="fl.faqEyebrow">FAQ</div>
        <h2 class="section__title reveal" style="--d:80ms" data-i18n="fl.faqTitle">常见问题</h2>
      </div>

      <div class="steps reveal" data-stagger="70">
        <div class="step">
          <div class="step__n">Q1</div>
          <div>
            <div class="step__t" data-i18n="fl.q1t">关注之后能看到什么？</div>
            <p class="step__d" data-i18n="fl.q1d">
              对局片段、队徽与入场动画、印花与周边更新。不会发广告，也不会刷屏。
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step__n">Q2</div>
          <div>
            <div class="step__t" data-i18n="fl.q2t">怎么联系战队本人？</div>
            <p class="step__d" data-i18n="fl.q2d">
              私信 B 站频道即可，我们会看。群里和 Discord 还在筹备，开通后会补在这里。
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step__n">Q3</div>
          <div>
            <div class="step__t" data-i18n="fl.q3t">能一起开黑吗？</div>
            <p class="step__d" data-i18n="fl.q3d">
              能。我们没有试训、没有段位线，私信说一声想一起玩就行，合得来就一起排。
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step__n">Q4</div>
          <div>
            <div class="step__t" data-i18n="fl.q4t">会把素材发给我用吗？</div>
            <p class="step__d" data-i18n="fl.q4d">
              队徽、印花这类队内素材随便用来做二创或表情包，署名不署名都行，
              别拿去冒充官方就成。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--divide" style="padding-top:0">
    <div class="shell">
      <div class="card reveal reveal--scale" style="padding:48px 40px;text-align:center">
        <div class="section__head section__head--center" style="margin-bottom:26px">
          <div class="eyebrow" data-i18n="fl.playEyebrow">Play with us</div>
          <h2 class="section__title" data-i18n="fl.playTitle">如果你也只想好好打游戏</h2>
          <p class="section__lede" data-i18n="fl.playLede">
            没有试训、没有考核、没有水平线。合得来就一起开黑，合不来也不会有人为难你。
          </p>
        </div>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--ghost" href="about.html" data-i18n="fl.playRules">先看看队内约定</a>
          <a class="btn btn--ghost" href="players.html" data-i18n="fl.playRoster">看看都有谁</a>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
    (function () {
      'use strict';
      var JB = window.JB;

      /* esc() 由 assets/js/main.js 统一提供（window.JB_UI.esc），此处不再重复定义 */
      var esc = window.JB_UI.esc;

      function channel(key) {
        return JB.CONTACT.filter(function (c) { return c.key === key; })[0] || null;
      }

      /* -------------------------------------------------------------------
         主频道卡片：B 站整块展示，带渐变描边和明确的跳转按钮
         ------------------------------------------------------------------- */
      function renderFeatured() {
        var host = document.getElementById('channel-featured');
        var c = channel('bilibili');
        if (!c) { host.hidden = true; return; }

        var name = JB_UI.pick(c.value);
        var href = c.href || '';

        host.innerHTML =
          '<div class="channel__glow" aria-hidden="true"></div>' +
          '<div class="channel__body">' +
            '<span class="channel__badge">' +
              '<span class="channel__dot" aria-hidden="true"></span>' +
              esc(JB_UI.pick({ cn: '官方频道', en: 'Official channel' })) +
            '</span>' +
            '<h2 class="channel__name">' + esc(name) + '</h2>' +
            '<div class="channel__platform">' + esc(JB_UI.pick(c.label)) + '</div>' +
            '<p class="channel__note">' + esc(JB_UI.pick(c.note)) + '</p>' +
            (href
              ? '<div class="btn-row">' +
                  '<a class="btn btn--primary" href="' + esc(href) + '" target="_blank" rel="noopener">' +
                    '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="14" height="14" rx="2.5"/><path d="M16 10.5l6-3.5v10l-6-3.5z"/></svg>' +
                    '<span>' + esc(JB_UI.pick({ cn: '前往 B 站频道', en: 'Open on Bilibili' })) + '</span>' +
                  '</a>' +
                  '<span class="channel__url">' + esc(href.replace(/^https?:\/\//, '').split('?')[0]) + '</span>' +
                '</div>'
              : '<p class="channel__note">' + esc(JB_UI.pick(c.placeholder)) + '</p>') +
          '</div>';
      }

      /* -------------------------------------------------------------------
         其他账号：有内容的显示为可点卡片，留空的显示为待开通
         ------------------------------------------------------------------- */
      function renderOthers() {
        var host = document.getElementById('contact-grid');
        if (!host) return;

        var others = JB.CONTACT.filter(function (c) { return c.key !== 'bilibili'; });

        host.innerHTML = others.map(function (c) {
          var filled = !!(c.value || c.href);
          var shown = filled ? JB_UI.pick(c.value) : JB_UI.pick(c.placeholder);

          var body =
            '<div class="contact__icon" aria-hidden="true">' + (JB_UI.icon[c.icon] || JB_UI.icon.chat) + '</div>' +
            '<div>' +
              '<div class="contact__k">' + esc(JB_UI.pick(c.label)) + '</div>' +
              '<div class="contact__v' + (filled ? '' : ' contact__v--pending') + '">' + esc(shown) + '</div>' +
            '</div>';

          return c.href
            ? '<a class="contact" href="' + esc(c.href) + '" target="_blank" rel="noopener">' + body + '</a>'
            : '<div class="contact">' + body + '</div>';
        }).join('');
      }

      window.JB_I18N = window.JB_I18N || {};
      Object.assign(window.JB_I18N, {
        'fl.eyebrow': { cn: 'Follow us', en: 'Follow us' },
        'fl.title': { cn: '关注我们', en: 'Follow us' },
        'fl.lede': {
          cn: '队内对局片段、入场动画、印花与新素材，都发在哔哩哔哩频道。目前我们只运营这一个账号 —— 想看到更新，在这里关注就够了。',
          en: 'Match clips, entry animations, stickers and new assets all go up on Bilibili. It is the only account we run — following there is enough to keep up.'
        },
        'fl.contentEyebrow': { cn: 'What we post', en: 'What we post' },
        'fl.contentTitle': { cn: '频道里会有什么', en: 'What you will find there' },
        'fl.c1t': { cn: '对局片段', en: 'Match clips' },
        'fl.c1d': {
          cn: '队内对抗与组队局里值得留下的片段。高光会剪，失误也不会藏着 —— 本来就是我们真实的样子。',
          en: 'The clips worth keeping from internal scrims and queue games. Highlights get edited; mistakes are not hidden — that is genuinely what we look like.'
        },
        'fl.c2t': { cn: '队徽与入场动画', en: 'Crest and entry animations' },
        'fl.c2d': {
          cn: '队徽动画、入场序列的成片与新版本。这些素材在素材库里也能直接看。',
          en: 'Crest animations and entry sequences, finished and versioned. They are also viewable directly in the media library.'
        },
        'fl.c3t': { cn: '印花与周边', en: 'Stickers and extras' },
        'fl.c3d': {
          cn: '队服设计、选手印花、贴纸与签名的发布与更新，新做出来一张就更新一次。',
          en: 'Jersey designs, player stickers, sticker sheets and signatures, updated whenever a new one is finished.'
        },
        'fl.otherEyebrow': { cn: 'Other channels', en: 'Other channels' },
        'fl.otherTitle': { cn: '其他账号', en: 'Other accounts' },
        'fl.otherLede': {
          cn: '目前只有 B 站一个正式账号。下面这些渠道还在准备，开通之后会在这里补上。',
          en: 'Bilibili is currently our only official account. The channels below are still being set up and will be listed here once they open.'
        },
        'fl.faqEyebrow': { cn: 'FAQ', en: 'FAQ' },
        'fl.faqTitle': { cn: '常见问题', en: 'Common questions' },
        'fl.q1t': { cn: '关注之后能看到什么？', en: 'What will I see after following?' },
        'fl.q1d': {
          cn: '对局片段、队徽与入场动画、印花与周边更新。不会发广告，也不会刷屏。',
          en: 'Match clips, crest and entry animations, and sticker or merch updates. No ads and no spamming.'
        },
        'fl.q2t': { cn: '怎么联系战队本人？', en: 'How do I reach the team itself?' },
        'fl.q2d': {
          cn: '私信 B 站频道即可，我们会看。群里和 Discord 还在筹备，开通后会补在这里。',
          en: 'Send a direct message to the Bilibili channel — we read them. Group chat and Discord are still being set up and will be added here.'
        },
        'fl.q3t': { cn: '能一起开黑吗？', en: 'Can I play with you?' },
        'fl.q3d': {
          cn: '能。我们没有试训、没有段位线，私信说一声想一起玩就行，合得来就一起排。',
          en: 'Yes. No tryouts and no rank requirement — just message us that you want to play, and if we click we queue together.'
        },
        'fl.q4t': { cn: '会把素材发给我用吗？', en: 'May I use your assets?' },
        'fl.q4d': {
          cn: '队徽、印花这类队内素材随便用来做二创或表情包，署名不署名都行，别拿去冒充官方就成。',
          en: 'Team assets like the crest and player stickers are free to use for fan art or memes, with or without credit — just do not pass them off as official.'
        },
        'fl.playEyebrow': { cn: 'Play with us', en: 'Play with us' },
        'fl.playTitle': { cn: '如果你也只想好好打游戏', en: 'If you just want to play the game properly' },
        'fl.playLede': {
          cn: '没有试训、没有考核、没有水平线。合得来就一起开黑，合不来也不会有人为难你。',
          en: 'No tryouts, no evaluation, no skill floor. If we click, we queue together. If not, nobody will give you a hard time.'
        },
        'fl.playRules': { cn: '先看看队内约定', en: 'Read our house rules' },
        'fl.playRoster': { cn: '看看都有谁', en: 'See who is on the roster' }
      });

      renderFeatured();
      renderOthers();

      window.JB_onLang = window.JB_onLang || [];
      window.JB_onLang.push(function () {
        renderFeatured();
        renderOthers();
      });
    })();
    </script>
  </Fragment>

  {/* is:global：频道卡与联络网格由 innerHTML 生成 */}
  <style is:global>
    /* ------------------------------------------------------------------------
       主频道卡片 —— 全站唯一一处"重点推荐"的大卡片
       ------------------------------------------------------------------------ */
    .channel {
      position: relative;
      padding: 48px 44px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line-strong);
      background: linear-gradient(150deg, var(--tile-top), var(--tile-bottom));
      overflow: hidden;
      isolation: isolate;
    }
    /* 背后一层缓慢流动的渐变，暗示"视频流" */
    .channel__glow {
      position: absolute;
      inset: -30% -10%;
      z-index: -1;
      background:
        radial-gradient(ellipse 55% 60% at 18% 20%, var(--glow-a), transparent 62%),
        radial-gradient(ellipse 50% 55% at 85% 80%, var(--glow-b), transparent 62%);
      opacity: .5;
      filter: blur(50px);
      animation: drift-a calc(var(--t-ambient) * 1.1) var(--ease-soft) infinite alternate;
    }
    .channel__body { position: relative; max-width: 700px; }
    .channel__badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 6px 15px;
      margin-bottom: 20px;
      border-radius: 999px;
      background: var(--chip-bg);
      border: 1px solid var(--line-strong);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--cyan);
    }
    .channel__dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--win);
      box-shadow: 0 0 0 0 rgba(52, 211, 153, .6);
      animation: pulse 2.6s var(--ease-soft) infinite;
      flex: none;
    }
    .channel__name {
      font-size: clamp(26px, 4vw, 40px);
      margin-bottom: 10px;
      background: var(--grad);
      background-size: 220% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: grad-pan 9s var(--ease-soft) infinite alternate;
    }
    .channel__platform {
      font-family: var(--font-mono);
      font-size: 12.5px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--text-mute);
      margin-bottom: 20px;
    }
    .channel__note {
      font-size: 16.5px;
      line-height: 1.85;
      color: var(--text-soft);
      margin-bottom: 30px;
      max-width: 620px;
    }
    .channel__url {
      font-family: var(--font-mono);
      font-size: 12.5px;
      color: var(--text-mute);
      word-break: break-all;
    }
    @media (max-width: 640px) {
      .channel { padding: 32px 24px; }
      .channel__note { font-size: 15.5px; }
    }
  </style>

</BaseLayout>
